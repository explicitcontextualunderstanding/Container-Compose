# Cloudflare Access Service Account Template
# Copy to ops.env and fill in your 1Password references
#
# Usage:
# 1. Create cloudflare_service_tokens in 1Password vault 'tokens'
# 2. Add fields: header_and_client_id, header_and_client_secret
# 3. Copy this file: cp ops.env.example ops.env
# 4. Run tests: op run --env-file=ops.env -- swift test

CF_ACCESS_CLIENT_ID="op://tokens/cloudflare_service_tokens/header_and_client_id"
CF_ACCESS_CLIENT_SECRET="op://tokens/cloudflare_service_tokens/header_and_client_secret"

# Zot Registry URL (via cloudflared tunnel)
OCI_REGISTRY_URL="registry.example.com"

# Alternative: Direct IP access (for fallback)
ZOT_REGISTRY_IP="192.168.1.86:30500"
