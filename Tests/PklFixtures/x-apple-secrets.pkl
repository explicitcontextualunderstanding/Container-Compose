amends "../../Sources/Container-Compose/Internal/Schemas/HonchoPod.pkl"
import "../../Sources/Container-Compose/Internal/Schemas/Service.pkl"

/// Apple secrets configuration fixture — exercises: x_apple_secrets (mount, cleanup, permissions, filter)
services {
  ["secure-app"] {
    image = "app:latest"
    x_apple_secrets {
      mount = "/run/secrets"
      read_only = true
      noexec = true
      nosuid = true
      cleanup = "immediate"
      filter {
        "db_password"
        "api_key"
        "tls_cert"
      }
    }
    environment {
      ["SECRETS_DIR"] = "/run/secrets"
    }
    configs = new Listing {
      new Service.ServiceConfig {
        source = "app_config"
        target = "/etc/app/config.json"
        uid = "1000"
        gid = "1000"
        mode = 0o644
      }
    }
    secrets = new Listing {
      new Service.ServiceSecret {
        source = "db_password"
        target = "/run/secrets/db_password"
        uid = "1000"
        gid = "1000"
        mode = 0o400
      }
    }
  }
}
